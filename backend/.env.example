# MaskGuard AI Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (MongoDB)
# If local MongoDB is not running, the application includes an automated embedded fallback engine
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=maskguard_db

# Security & Authentication
SECRET_KEY=maskguard-production-secret-change-in-prod-super-secure-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Computer Vision Provider Configuration
# Supported providers: 'roboflow', 'huggingface', 'local_cv', 'unconfigured', 'demo'
# In production, set AI_PROVIDER=roboflow or huggingface with real credentials.
# If credentials are not supplied, set AI_PROVIDER=unconfigured (will show clear guidance).
# For isolated developer demonstration, set AI_PROVIDER=demo (tagged explicitly with DEMO watermark).
AI_PROVIDER=demo
AI_API_BASE_URL=https://detect.roboflow.com
AI_API_KEY=
AI_MODEL=mask-wearing-detection/1
AI_REQUEST_TIMEOUT_SECONDS=10.0

# System Detection & Event Defaults
CONFIDENCE_THRESHOLD=0.60
ALERT_COOLDOWN_SECONDS=15
FRAME_INTERVAL_MS=800
RETENTION_DAYS=30
IMAGE_RETENTION_ENABLED=false
MAX_UPLOAD_SIZE_MB=10

# Initial Admin Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@maskguard.ai
BOOTSTRAP_ADMIN_PASSWORD=AdminMaskGuard2026!
BOOTSTRAP_ADMIN_NAME="System Administrator"
